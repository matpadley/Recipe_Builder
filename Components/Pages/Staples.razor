@page "/staples"
@using RecipeIngredients.Models
@using RecipeIngredients.Services
@inject IStapleStore Store
@inject ISnackbar Snackbar
@inject IDialogService DialogService

<PageTitle>Kitchen Staples</PageTitle>

<MudText Typo="Typo.h4" Class="mb-1">Kitchen Staples</MudText>
<MudText Typo="Typo.body2" Class="mb-4">
    Spices, oils, sauces and other basics. No amounts — just switch one off when it runs out.
</MudText>

<MudPaper Class="pa-3 mb-4 d-flex align-center gap-2" Elevation="2">
    <MudTextField @bind-Value="_newName"
                  Label="Add staple"
                  Placeholder="e.g. Ground cumin"
                  Variant="Variant.Outlined"
                  Margin="Margin.Dense"
                  Immediate="true"
                  Error="IsNewNameDuplicate"
                  ErrorText="@($"\"{_newName.Trim()}\" is already in your staples.")"
                  OnKeyDown="OnNewNameKeyDown" />
    <MudIconButton Icon="@Icons.Material.Filled.Add"
                   Color="Color.Primary"
                   Variant="Variant.Filled"
                   Disabled="string.IsNullOrWhiteSpace(_newName) || IsNewNameDuplicate"
                   OnClick="AddStaple" />
</MudPaper>

<MudTable Items="_staples"
          Loading="_staples is null"
          LoadingProgressColor="Color.Primary"
          Hover="true"
          Striped="true"
          Dense="true"
          Elevation="2"
          Breakpoint="Breakpoint.None">
    <HeaderContent>
        <MudTh><MudTableSortLabel SortBy="new Func<Staple, object>(x => x.Name)">Staple</MudTableSortLabel></MudTh>
        <MudTh Style="width: 120px;"><MudTableSortLabel SortBy="new Func<Staple, object>(x => x.Available)">Available</MudTableSortLabel></MudTh>
        <MudTh Style="width: 96px;"></MudTh>
    </HeaderContent>
    <RowTemplate>
        <MudTd DataLabel="Staple">
            <MudText Typo="Typo.body2" Style="@(context.Available ? null : "opacity: 0.5; text-decoration: line-through;")">
                @context.Name
            </MudText>
        </MudTd>
        <MudTd DataLabel="Available">
            <MudSwitch T="bool"
                       Value="context.Available"
                       ValueChanged="@(value => SetAvailable(context, value))"
                       Color="Color.Success" />
        </MudTd>
        <MudTd DataLabel="Actions">
            <MudIconButton Icon="@Icons.Material.Filled.Edit"
                           Size="Size.Small"
                           Color="Color.Primary"
                           OnClick="@(() => OpenEditDialog(context))" />
            <MudIconButton Icon="@Icons.Material.Filled.Delete"
                           Size="Size.Small"
                           Color="Color.Error"
                           OnClick="@(() => DeleteStaple(context))" />
        </MudTd>
    </RowTemplate>
    <NoRecordsContent>
        <MudText Typo="Typo.body2">No staples yet.</MudText>
    </NoRecordsContent>
    <LoadingContent>
        <MudText Typo="Typo.body2">Loading...</MudText>
    </LoadingContent>
</MudTable>

@code {
    private List<Staple>? _staples;
    private string _newName = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        await LoadStaples();
    }

    private async Task LoadStaples()
    {
        _staples = (await Store.GetAllAsync())
            .OrderBy(s => s.Name, StringComparer.OrdinalIgnoreCase)
            .ToList();
    }

    private bool IsNewNameDuplicate =>
        !string.IsNullOrWhiteSpace(_newName)
        && _staples?.Any(s => string.Equals(s.Name, _newName.Trim(), StringComparison.OrdinalIgnoreCase)) == true;

    private async Task OnNewNameKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await AddStaple();
        }
    }

    private async Task AddStaple()
    {
        var name = _newName.Trim();
        if (name.Length == 0)
        {
            return;
        }

        if (IsNewNameDuplicate)
        {
            return;
        }

        await Store.AddAsync(new Staple { Name = name });

        _newName = string.Empty;
        Snackbar.Add($"Added {name}.", Severity.Success);
        await LoadStaples();
    }

    private async Task SetAvailable(Staple staple, bool available)
    {
        staple.Available = available;
        await Store.UpdateAsync(staple);
    }

    private async Task OpenEditDialog(Staple staple)
    {
        var parameters = new DialogParameters<StapleDialog> 
        {
            { x => x.Staple, staple },
            { x => x.ExistingNames, _staples?.Where(s => s.Id != staple.Id).Select(s => s.Name).ToList() ?? [] }
        };
        var dialog = await DialogService.ShowAsync<StapleDialog>("Edit Staple", parameters);
        var result = await dialog.Result;

        if (result is { Canceled: false, Data: Staple updated })
        {
            updated.Name = updated.Name.Trim();
            await Store.UpdateAsync(updated);

            Snackbar.Add($"Updated {updated.Name}.", Severity.Success);
            await LoadStaples();
        }
    }

    private async Task DeleteStaple(Staple staple)
    {
        var confirmed = await DialogService.ShowMessageBoxAsync(
            "Delete Staple",
            $"Are you sure you want to delete \"{staple.Name}\"?",
            yesText: "Delete",
            cancelText: "Cancel");

        if (confirmed != true)
        {
            return;
        }

        await Store.DeleteAsync(staple.Id);

        Snackbar.Add($"Deleted {staple.Name}.", Severity.Success);
        await LoadStaples();
    }
}
