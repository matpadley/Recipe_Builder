@using RecipeIngredients.Models

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">Edit Staple</MudText>
    </TitleContent>
    <DialogContent>
        <MudForm @ref="_form" Model="_staple">
            <MudGrid Spacing="3">
                <MudItem xs="12">
                    <MudTextField @bind-Value="_staple.Name"
                                  For="@(() => _staple.Name)"
                                  Label="Staple"
                                  Placeholder="e.g. Ground cumin"
                                  Required="true"
                                  Variant="Variant.Outlined" />
                </MudItem>

                <MudItem xs="12">
                    <MudSwitch @bind-Value="_staple.Available"
                               Label="Available"
                               Color="Color.Success" />
                </MudItem>
            </MudGrid>
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Cancel</MudButton>
        <MudButton Color="Color.Primary"
                   Variant="Variant.Filled"
                   StartIcon="@Icons.Material.Filled.Save"
                   OnClick="Submit"
                   Disabled="_saving">
            @(_saving ? "Saving..." : "Save")
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;
    [Parameter, EditorRequired] public Staple Staple { get; set; } = default!;

    private MudForm _form = default!;
    private Staple _staple = new();
    private bool _saving;

    protected override void OnInitialized()
    {
        _staple = new Staple
        {
            Id = Staple.Id,
            Name = Staple.Name,
            Available = Staple.Available,
            CreatedAtUtc = Staple.CreatedAtUtc,
        };
    }

    private async Task Submit()
    {
        await _form.ValidateAsync();
        if (!_form.IsValid)
        {
            return;
        }

        _saving = true;
        MudDialog.Close(DialogResult.Ok(_staple));
    }

    private void Cancel() => MudDialog.Cancel();
}
